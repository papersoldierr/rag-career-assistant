# Copy this file to ".env" and fill in real values. .env is gitignored.

# Claude API key — generation. https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Voyage AI key — embeddings. https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Postgres connection string.
#
# Option A (recommended) — Supabase: copy the connection string from
#   Supabase dashboard -> Project Settings -> Database -> Connection string.
#   Use the "Session pooler" URI (IPv4-friendly) and append ?sslmode=require.
#   Example: postgresql://postgres.abcxyz:PASSWORD@aws-0-...pooler.supabase.com:5432/postgres?sslmode=require
#
# Option B — local Postgres via docker-compose.yml (needs Docker running):
#   postgresql://rag:rag@localhost:5432/ragdb
DATABASE_URL=
